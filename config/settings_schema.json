[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 80,
        "max": 300,
        "step": 10,
        "unit": "px",
        "default": 160
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Body font"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "Body font"
      },
      {
        "type": "range",
        "id": "body_font_scale",
        "label": "Body font scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "header",
        "content": "Heading font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n4",
        "label": "Heading font"
      },
      {
        "type": "range",
        "id": "heading_font_scale",
        "label": "Heading font scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Maximum page width",
        "options": [
          {
            "value": "90rem",
            "label": "Narrow"
          },
          {
            "value": "100rem",
            "label": "Medium"
          },
          {
            "value": "110rem",
            "label": "Wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 60,
        "step": 2,
        "unit": "px",
        "label": "Desktop page margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 20,
        "max": 140,
        "step": 5,
        "unit": "px",
        "label": "Desktop section spacing",
        "default": 70
      },
      {
        "type": "range",
        "id": "section_spacing_mobile",
        "min": 15,
        "max": 80,
        "step": 5,
        "unit": "px",
        "label": "Mobile section spacing",
        "default": 45
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "Background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#171717",
        "label": "Text"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#171717",
        "label": "Accent"
      },
      {
        "type": "color",
        "id": "secondary_background_color",
        "default": "#F7F4EF",
        "label": "Secondary background"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#DDD8D1",
        "label": "Borders"
      }
    ]
  },
  {
    "name": "Buttons and inputs",
    "settings": [
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 30,
        "step": 2,
        "unit": "px",
        "label": "Button corner radius",
        "default": 0
      },
      {
        "type": "range",
        "id": "button_height",
        "min": 40,
        "max": 64,
        "step": 2,
        "unit": "px",
        "label": "Button height",
        "default": 50
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Input corner radius",
        "default": 0
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Enable animations",
        "default": true
      },
      {
        "type": "select",
        "id": "animation_speed",
        "label": "Animation speed",
        "options": [
          {
            "value": "0.2s",
            "label": "Fast"
          },
          {
            "value": "0.4s",
            "label": "Normal"
          },
          {
            "value": "0.7s",
            "label": "Slow"
          }
        ],
        "default": "0.4s"
      }
    ]
  }
]
