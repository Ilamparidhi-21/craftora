{% comment %}
  Boutique all collections page
{% endcomment %}

<section
  class="boutique-collections"
  style="
    --collections-bg: {{ section.settings.background_color }};
    --collections-text: {{ section.settings.text_color }};
    --collections-columns: {{ section.settings.columns_desktop }};
  "
>

  <div class="boutique-collections__inner">

    <!-- HEADER -->
    <div class="boutique-collections__header">

      {% if section.settings.eyebrow != blank %}
        <p class="boutique-collections__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1>
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="boutique-collections__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

    </div>


    <!-- COLLECTION GRID -->
    {% paginate collections by section.settings.collections_per_page %}

      <div class="boutique-collections__grid">

        {% for collection in collections %}

          {% if section.settings.hide_empty_collections and collection.all_products_count == 0 %}
            {% continue %}
          {% endif %}


          <article class="boutique-collection-card">

            <a
              href="{{ collection.url }}"
              class="boutique-collection-card__media"
            >

              {% if collection.featured_image != blank %}

                {{
                  collection.featured_image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1200, 1400',
                    sizes: '(min-width: 990px) 33vw, 50vw'
                }}

              {% elsif collection.products.first.featured_image != blank %}

                {{
                  collection.products.first.featured_image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1200, 1400',
                    sizes: '(min-width: 990px) 33vw, 50vw'
                }}

              {% else %}

                {{ 'collection-1' | placeholder_svg_tag }}

              {% endif %}


              <div class="boutique-collection-card__overlay"></div>


              <div class="boutique-collection-card__content">

                <h2>
                  {{ collection.title }}
                </h2>

                {% if section.settings.show_product_count %}
                  <span class="boutique-collection-card__count">

                    {{ collection.all_products_count }}

                    {% if collection.all_products_count == 1 %}
                      PIECE
                    {% else %}
                      PIECES
                    {% endif %}

                  </span>
                {% endif %}


                {% if section.settings.show_collection_description and collection.description != blank %}

                  <p>
                    {{
                      collection.description
                      | strip_html
                      | truncatewords: 16
                    }}
                  </p>

                {% endif %}


                <span class="boutique-collection-card__link">
                  {{ section.settings.button_text }}
                  →
                </span>

              </div>

            </a>

          </article>

        {% endfor %}

      </div>


      {% if paginate.pages > 1 %}

        <nav
          class="boutique-collections-pagination"
          aria-label="Collections pagination"
        >

          <div>
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}">
                ← PREVIOUS
              </a>
            {% endif %}
          </div>


          <div class="boutique-collections-pagination__pages">

            {% for part in paginate.parts %}

              {% if part.is_link %}

                <a href="{{ part.url }}">
                  {{ part.title }}
                </a>

              {% else %}

                <span
                  {% if part.title == paginate.current_page %}
                    class="active"
                  {% endif %}
                >
                  {{ part.title }}
                </span>

              {% endif %}

            {% endfor %}

          </div>


          <div class="boutique-collections-pagination__next">
            {% if paginate.next %}
              <a href="{{ paginate.next.url }}">
                NEXT →
              </a>
            {% endif %}
          </div>

        </nav>

      {% endif %}

    {% endpaginate %}

  </div>

</section>


{% stylesheet %}

/* ==================================
   COLLECTIONS PAGE
================================== */

.boutique-collections {
  width: 100%;

  padding:
    70px
    25px
    95px;

  box-sizing: border-box;

  background: var(--collections-bg);
  color: var(--collections-text);
}

.boutique-collections__inner {
  width: min(100%, 1450px);

  margin: 0 auto;
}


/* ==================================
   HEADER
================================== */

.boutique-collections__header {
  max-width: 800px;

  margin:
    0
    auto
    55px;

  text-align: center;
}

.boutique-collections__eyebrow {
  margin:
    0
    0
    15px;

  font-size: 9px;
  font-weight: 600;

  letter-spacing: 0.22em;

  text-transform: uppercase;
}

.boutique-collections__header h1 {
  margin: 0;

  font-family: var(--font-heading-family);

  font-size:
    clamp(48px, 6vw, 82px);

  line-height: 1;

  font-weight: 400;
}

.boutique-collections__description {
  max-width: 580px;

  margin:
    20px
    auto
    0;

  font-size: 13px;

  line-height: 1.75;

  opacity: 0.65;
}

.boutique-collections__description p {
  margin: 0;
}


/* ==================================
   GRID
================================== */

.boutique-collections__grid {
  display: grid;

  grid-template-columns:
    repeat(
      var(--collections-columns),
      minmax(0, 1fr)
    );

  gap:
    18px;
}


/* ==================================
   COLLECTION CARD
================================== */

.boutique-collection-card {
  min-width: 0;
}

.boutique-collection-card__media {
  position: relative;

  display: block;

  min-height: 570px;

  overflow: hidden;

  background: #e8e3dc;

  color: #ffffff;

  text-decoration: none;
}

.boutique-collection-card__media img,
.boutique-collection-card__media svg {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform
    0.7s
    ease;
}

.boutique-collection-card:hover
.boutique-collection-card__media img {
  transform: scale(1.035);
}


/* OVERLAY */

.boutique-collection-card__overlay {
  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      to top,
      rgba(0, 0, 0, 0.52),
      rgba(0, 0, 0, 0.03) 60%
    );

  z-index: 1;
}


/* ==================================
   CARD TEXT
================================== */

.boutique-collection-card__content {
  position: absolute;

  left: 30px;
  right: 30px;
  bottom: 30px;

  z-index: 2;
}

.boutique-collection-card__content h2 {
  margin: 0;

  font-family: var(--font-heading-family);

  font-size:
    clamp(30px, 3vw, 42px);

  font-weight: 400;

  line-height: 1;
}

.boutique-collection-card__count {
  display: block;

  margin-top: 10px;

  font-size: 8px;

  letter-spacing: 0.16em;

  opacity: 0.8;
}

.boutique-collection-card__content p {
  max-width: 420px;

  margin:
    14px
    0
    0;

  font-size: 12px;

  line-height: 1.6;

  opacity: 0.82;
}

.boutique-collection-card__link {
  display: inline-block;

  margin-top: 19px;

  padding-bottom: 4px;

  border-bottom:
    1px solid currentColor;

  font-size: 9px;

  font-weight: 600;

  letter-spacing: 0.15em;

  text-transform: uppercase;
}


/* ==================================
   PAGINATION
================================== */

.boutique-collections-pagination {
  margin-top: 70px;

  padding-top: 28px;

  border-top:
    1px solid rgba(0, 0, 0, 0.13);

  display: grid;

  grid-template-columns:
    1fr
    auto
    1fr;

  align-items: center;
}

.boutique-collections-pagination a {
  color: inherit;

  text-decoration: none;

  font-size: 9px;

  letter-spacing: 0.13em;
}

.boutique-collections-pagination__pages {
  display: flex;

  align-items: center;

  justify-content: center;

  gap: 15px;
}

.boutique-collections-pagination__pages a,
.boutique-collections-pagination__pages span {
  font-size: 11px;

  opacity: 0.45;
}

.boutique-collections-pagination__pages .active {
  opacity: 1;

  border-bottom:
    1px solid currentColor;
}

.boutique-collections-pagination__next {
  text-align: right;
}


/* ==================================
   TABLET
================================== */

@media screen and (max-width: 950px) {

  .boutique-collections__grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .boutique-collection-card__media {
    min-height: 520px;
  }

}


/* ==================================
   MOBILE
================================== */

@media screen and (max-width: 600px) {

  .boutique-collections {
    padding:
      50px
      15px
      70px;
  }

  .boutique-collections__header {
    margin-bottom: 38px;
  }

  .boutique-collections__header h1 {
    font-size: 48px;
  }

  .boutique-collections__grid {
    grid-template-columns: 1fr;

    gap: 12px;
  }

  .boutique-collection-card__media {
    min-height: 510px;
  }

  .boutique-collection-card__content {
    left: 22px;
    right: 22px;
    bottom: 25px;
  }

  .boutique-collections-pagination {
    margin-top: 50px;

    gap: 8px;
  }

  .boutique-collections-pagination__pages {
    gap: 8px;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Boutique collections",

  "settings": [

    {
      "type": "header",
      "content": "Heading"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "EXPLORE"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop The Collections"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover thoughtfully curated edits designed for every mood and moment.</p>"
    },


    {
      "type": "header",
      "content": "Collection cards"
    },

    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },

    {
      "type": "range",
      "id": "collections_per_page",
      "label": "Collections per page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12
    },

    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show collection description",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "hide_empty_collections",
      "label": "Hide empty collections",
      "default": false
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Link text",
      "default": "SHOP COLLECTION"
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#171717"
    }

  ]
}
{% endschema %}
