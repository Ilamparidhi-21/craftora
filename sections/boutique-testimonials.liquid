<section
  class="boutique-testimonials"
  style="
    --testimonial-bg: {{ section.settings.background_color }};
    --testimonial-text: {{ section.settings.text_color }};
    --testimonial-border: {{ section.settings.border_color }};
  "
>
  <div class="boutique-testimonials__inner">

    <div class="boutique-testimonials__header">

      {% if section.settings.eyebrow != blank %}
        <p class="boutique-testimonials__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="boutique-testimonials__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

    </div>


    <div class="boutique-testimonials__grid">

      {% for block in section.blocks %}

        <article
          class="boutique-testimonial"
          {{ block.shopify_attributes }}
        >

          {% if section.settings.show_stars %}
            <div
              class="boutique-testimonial__stars"
              aria-label="5 out of 5 stars"
            >
              ★ ★ ★ ★ ★
            </div>
          {% endif %}


          {% if block.settings.quote != blank %}
            <blockquote>
              “{{ block.settings.quote }}”
            </blockquote>
          {% endif %}


          <div class="boutique-testimonial__author">

            {% if block.settings.name != blank %}
              <strong>
                {{ block.settings.name }}
              </strong>
            {% endif %}

            {% if block.settings.details != blank %}
              <span>
                {{ block.settings.details }}
              </span>
            {% endif %}

          </div>

        </article>

      {% endfor %}

    </div>

  </div>
</section>


{% stylesheet %}

.boutique-testimonials {
  width: 100%;

  padding: 85px 25px;

  background: var(--testimonial-bg);
  color: var(--testimonial-text);
}

.boutique-testimonials__inner {
  width: min(100%, 1450px);

  margin: 0 auto;
}


/* ===============================
   HEADER
================================ */

.boutique-testimonials__header {
  max-width: 700px;

  margin: 0 auto 50px;

  text-align: center;
}

.boutique-testimonials__eyebrow {
  margin: 0 0 16px;

  font-size: 10px;
  font-weight: 600;

  letter-spacing: 0.22em;

  text-transform: uppercase;
}

.boutique-testimonials__header h2 {
  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: clamp(36px, 4vw, 56px);

  font-weight: 400;

  line-height: 1.05;
}

.boutique-testimonials__description {
  max-width: 560px;

  margin: 18px auto 0;

  font-size: 14px;
  line-height: 1.7;

  opacity: 0.66;
}

.boutique-testimonials__description p {
  margin: 0;
}


/* ===============================
   TESTIMONIAL GRID
================================ */

.boutique-testimonials__grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  border-top:
    1px solid var(--testimonial-border);

  border-bottom:
    1px solid var(--testimonial-border);
}


/* ===============================
   CARD
================================ */

.boutique-testimonial {
  min-height: 300px;

  padding: 45px 42px;

  display: flex;
  flex-direction: column;

  justify-content: space-between;

  border-right:
    1px solid var(--testimonial-border);
}

.boutique-testimonial:last-child {
  border-right: 0;
}


/* ===============================
   STARS
================================ */

.boutique-testimonial__stars {
  margin-bottom: 28px;

  font-size: 11px;

  letter-spacing: 0.15em;
}


/* ===============================
   QUOTE
================================ */

.boutique-testimonial blockquote {
  flex: 1;

  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: clamp(21px, 2vw, 27px);

  line-height: 1.35;

  font-weight: 400;
}


/* ===============================
   AUTHOR
================================ */

.boutique-testimonial__author {
  margin-top: 35px;

  display: flex;
  flex-direction: column;

  gap: 5px;
}

.boutique-testimonial__author strong {
  font-size: 10px;
  font-weight: 600;

  letter-spacing: 0.14em;

  text-transform: uppercase;
}

.boutique-testimonial__author span {
  font-size: 11px;

  opacity: 0.55;
}


/* ===============================
   TABLET
================================ */

@media screen and (max-width: 900px) {

  .boutique-testimonials__grid {
    grid-template-columns: 1fr;
  }

  .boutique-testimonial {
    min-height: auto;

    border-right: 0;

    border-bottom:
      1px solid var(--testimonial-border);
  }

  .boutique-testimonial:last-child {
    border-bottom: 0;
  }

}


/* ===============================
   MOBILE
================================ */

@media screen and (max-width: 550px) {

  .boutique-testimonials {
    padding:
      60px
      15px;
  }

  .boutique-testimonials__header {
    margin-bottom: 35px;
  }

  .boutique-testimonial {
    padding:
      35px
      20px;
  }

  .boutique-testimonial blockquote {
    font-size: 22px;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Boutique testimonials",

  "settings": [

    {
