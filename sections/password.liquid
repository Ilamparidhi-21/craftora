{% comment %}
  Boutique Password / Coming Soon Page
{% endcomment %}

<section
  class="boutique-password"
  style="
    --password-bg: {{ section.settings.background_color }};
    --password-text: {{ section.settings.text_color }};
    --password-button-bg: {{ section.settings.button_background }};
    --password-button-text: {{ section.settings.button_text_color }};
    --password-border: {{ section.settings.border_color }};
    --password-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>

  {% if section.settings.background_image != blank %}

    <div class="boutique-password__background">

      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          widths: '750, 1100, 1500, 1800, 2200, 2400',
          sizes: '100vw'
      }}

    </div>

    <div class="boutique-password__overlay"></div>

  {% endif %}


  <div class="boutique-password__inner">

    <!-- TOP -->
    <div class="boutique-password__top">

      <a
        href="{{ routes.root_url }}"
        class="boutique-password__brand"
        aria-label="{{ shop.name }}"
      >

        {% if section.settings.logo != blank %}

          {{
            section.settings.logo
            | image_url: width: 500
            | image_tag:
              loading: 'eager',
              widths: '160, 240, 320, 400, 500',
              class: 'boutique-password__logo'
          }}

        {% else %}

          <span>
            {{ shop.name }}
          </span>

        {% endif %}

      </a>


      <button
        type="button"
        class="boutique-password__login-trigger"
        data-password-open
      >
        STORE ACCESS
      </button>

    </div>


    <!-- MAIN CONTENT -->
    <div class="boutique-password__content">

      {% if section.settings.eyebrow != blank %}
        <p class="boutique-password__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}


      {% if section.settings.heading != blank %}
        <h1>
          {{ section.settings.heading }}
        </h1>
      {% endif %}


      {% if shop.password_message != blank %}

        <div class="boutique-password__message">
          {{ shop.password_message }}
        </div>

      {% elsif section.settings.description != blank %}

        <div class="boutique-password__message">
          {{ section.settings.description }}
        </div>

      {% endif %}


      {% if section.settings.show_newsletter %}

        <div class="boutique-password__newsletter">

          {% if section.settings.newsletter_heading != blank %}
            <p class="boutique-password__newsletter-heading">
              {{ section.settings.newsletter_heading }}
            </p>
          {% endif %}


          {% form 'customer' %}

            <input
              type="hidden"
              name="contact[tags]"
              value="newsletter"
            >

            {% if form.posted_successfully? %}

              <p
                class="boutique-password__success"
                tabindex="-1"
               role="status" aria-live="polite">
                {{ section.settings.newsletter_success }}
              </p>

            {% else %}

              <div class="boutique-password__newsletter-form">

                <label
                  for="PasswordNewsletterEmail"
                  class="visually-hidden"
                >
                  Email address
                </label>

                <input
                  id="PasswordNewsletterEmail"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  autocomplete="email"
                  autocapitalize="off"
                  spellcheck="false"
                  required
                  placeholder="{{ section.settings.email_placeholder }}"
                >

                <button type="submit">
                  {{ section.settings.newsletter_button }}
                </button>

              </div>

            {% endif %}


            {% if form.errors %}
              <div class="boutique-password__errors" role="alert" aria-live="assertive">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

          {% endform %}

        </div>

      {% endif %}


      {% if section.settings.note != blank %}

        <p class="boutique-password__note">
          {{ section.settings.note }}
        </p>

      {% endif %}

    </div>


    <!-- BOTTOM -->
    <div class="boutique-password__bottom">

      <div class="boutique-password__socials">

        {% if section.settings.instagram_url != blank %}
          <a
            href="{{ section.settings.instagram_url }}"
            target="_blank"
            rel="noopener"
          >
            Instagram
          </a>
        {% endif %}

        {% if section.settings.facebook_url != blank %}
          <a
            href="{{ section.settings.facebook_url }}"
            target="_blank"
            rel="noopener"
          >
            Facebook
          </a>
        {% endif %}

        {% if section.settings.pinterest_url != blank %}
          <a
            href="{{ section.settings.pinterest_url }}"
            target="_blank"
            rel="noopener"
          >
            Pinterest
          </a>
        {% endif %}

        {% if section.settings.tiktok_url != blank %}
          <a
            href="{{ section.settings.tiktok_url }}"
            target="_blank"
            rel="noopener"
          >
            TikTok
          </a>
        {% endif %}

      </div>


      <p class="boutique-password__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
      </p>

    </div>

  </div>


  <!-- PASSWORD DRAWER -->
  <div
    class="boutique-password-modal"
    data-password-modal
    aria-hidden="true"
  >

    <button
      type="button"
      class="boutique-password-modal__backdrop"
      data-password-close
      aria-label="Close password form"
    ></button>


    <div
      class="boutique-password-modal__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="PasswordModalHeading"
    >

      <button
        type="button"
        class="boutique-password-modal__close"
        data-password-close
        aria-label="Close"
      >
        ×
      </button>


      <p class="boutique-password-modal__eyebrow">
        PRIVATE ACCESS
      </p>


      <h2 id="PasswordModalHeading">
        Enter Store
      </h2>


      <p class="boutique-password-modal__description">
        Enter your password below to access the store.
      </p>


      {% form 'storefront_password' %}

        {% if form.errors %}

          <div class="boutique-password__errors" role="alert" aria-live="assertive">
            {{ form.errors | default_errors }}
          </div>

        {% endif %}


        <div class="boutique-password-modal__field">

          <label for="PasswordInput">
            Password
          </label>

          <input
            id="PasswordInput"
            type="password"
            name="password"
            autocomplete="current-password"
            required
            placeholder="Enter password"
          >

        </div>


        <button
          type="submit"
          class="boutique-password-modal__submit"
        >
          ENTER STORE
        </button>

      {% endform %}

    </div>

  </div>

</section>


{% stylesheet %}

/* ================================
   PASSWORD PAGE
================================ */

.boutique-password {
  position: relative;

  min-height: 100vh;

  background: var(--password-bg);
  color: var(--password-text);

  overflow: hidden;
}


/* BACKGROUND */

.boutique-password__background {
  position: absolute;

  inset: 0;

  z-index: 0;
}

.boutique-password__background img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}

.boutique-password__overlay {
  position: absolute;

  inset: 0;

  z-index: 1;

  background: rgba(
    0,
    0,
    0,
    var(--password-overlay)
  );
}


/* WRAPPER */

.boutique-password__inner {
  position: relative;

  z-index: 2;

  min-height: 100vh;

  padding:
    35px
    45px;

  box-sizing: border-box;

  display: grid;

  grid-template-rows:
    auto
    1fr
    auto;
}


/* TOP */

.boutique-password__top {
  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 30px;
}

.boutique-password__brand {
  color: inherit;

  text-decoration: none;

  font-family: var(--font-heading-family);

  font-size: 24px;

  letter-spacing: 0.08em;
}

.boutique-password__logo {
  display: block;

  width: auto;

  max-width: 180px;

  max-height: 60px;

  object-fit: contain;
}

.boutique-password__login-trigger {
  padding: 0;

  border: 0;

  border-bottom:
    1px solid currentColor;

  background: transparent;

  color: inherit;

  font-size: 8px;

  font-weight: 600;

  letter-spacing: 0.16em;

  text-transform: uppercase;

  cursor: pointer;
}


/* MAIN CONTENT */

.boutique-password__content {
  width: min(100%, 780px);

  margin: auto;

  padding:
    80px
    20px;

  text-align: center;
}

.boutique-password__eyebrow {
  margin:
    0
    0
    18px;

  font-size: 9px;

  font-weight: 600;

  letter-spacing: 0.24em;

  text-transform: uppercase;
}

.boutique-password__content h1 {
  margin: 0;

  font-family: var(--font-heading-family);

  font-size:
    clamp(58px, 9vw, 125px);

  line-height: 0.92;

  font-weight: 400;

  letter-spacing: -0.035em;
}

.boutique-password__message {
  width: min(100%, 580px);

  margin:
    28px
    auto
    0;

  font-size: 14px;

  line-height: 1.75;

  opacity: 0.82;
}

.boutique-password__message p {
  margin: 0;
}


/* NEWSLETTER */

.boutique-password__newsletter {
  width: min(100%, 540px);

  margin:
    42px
    auto
    0;
}

.boutique-password__newsletter-heading {
  margin:
    0
    0
    14px;

  font-size: 9px;

  font-weight: 600;

  letter-spacing: 0.15em;

  text-transform: uppercase;
}

.boutique-password__newsletter-form {
  display: grid;

  grid-template-columns:
    1fr
    auto;

  border-bottom:
    1px solid currentColor;
}

.boutique-password__newsletter-form input {
  min-width: 0;

  padding:
    14px
    5px;

  border: 0;

  background: transparent;

  color: inherit;

  font: inherit;

  font-size: 13px;

  
}

.boutique-password__newsletter-form input::placeholder {
  color: inherit;

  opacity: 0.65;
}

.boutique-password__newsletter-form button {
  padding:
    0
    5px
    0
    25px;

  border: 0;

  background: transparent;

  color: inherit;

  font-size: 8px;

  font-weight: 600;

  letter-spacing: 0.15em;

  cursor: pointer;
}

.boutique-password__success {
  padding:
    15px;

  border:
    1px solid currentColor;

  font-size: 13px;
}

.boutique-password__note {
  margin:
    18px
    0
    0;

  font-size: 10px;

  opacity: 0.65;
}


/* BOTTOM */

.boutique-password__bottom {
  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 30px;
}

.boutique-password__socials {
  display: flex;

  flex-wrap: wrap;

  gap: 18px;
}

.boutique-password__socials a {
  color: inherit;

  text-decoration: none;

  font-size: 8px;

  letter-spacing: 0.12em;

  text-transform: uppercase;
}

.boutique-password__copyright {
  margin: 0;

  font-size: 8px;

  letter-spacing: 0.1em;

  text-transform: uppercase;

  opacity: 0.7;
}


/* ERRORS */

.boutique-password__errors {
  margin-bottom: 18px;

  padding: 12px 15px;

  border:
    1px solid currentColor;

  font-size: 12px;

  text-align: left;
}

.boutique-password__errors ul {
  margin: 0;

  padding-left: 18px;
}


/* ================================
   PASSWORD MODAL
================================ */

.boutique-password-modal {
  position: fixed;

  inset: 0;

  z-index: 9999;

  display: flex;

  justify-content: flex-end;

  visibility: hidden;

  opacity: 0;

  transition:
    opacity 0.25s ease,
    visibility 0.25s ease;
}

.boutique-password-modal.is-open {
  visibility: visible;

  opacity: 1;
}

.boutique-password-modal__backdrop {
  position: absolute;

  inset: 0;

  width: 100%;

  border: 0;

  background:
    rgba(0, 0, 0, 0.4);

  cursor: pointer;
}

.boutique-password-modal__panel {
  position: relative;

  z-index: 1;

  width: min(100%, 480px);

  min-height: 100vh;

  padding:
    80px
    55px;

  box-sizing: border-box;

  background: var(--password-bg);

  color: var(--password-text);

  display: flex;

  flex-direction: column;

  justify-content: center;
}

.boutique-password-modal__close {
  position: absolute;

  top: 25px;
  right: 30px;

  border: 0;

  background: transparent;

  color: inherit;

  font-size: 30px;

  font-weight: 300;

  cursor: pointer;
}

.boutique-password-modal__eyebrow {
  margin:
    0
    0
    12px;

  font-size: 8px;

  letter-spacing: 0.18em;

  text-transform: uppercase;
}

.boutique-password-modal h2 {
  margin: 0;

  font-family: var(--font-heading-family);

  font-size: 48px;

  font-weight: 400;
}

.boutique-password-modal__description {
  margin:
    15px
    0
    35px;

  font-size: 13px;

  line-height: 1.6;

  opacity: 0.68;
}

.boutique-password-modal__field {
  margin-bottom: 25px;
}

.boutique-password-modal__field label {
  display: block;

  margin-bottom: 8px;

  font-size: 8px;

  font-weight: 600;

  letter-spacing: 0.14em;

  text-transform: uppercase;
}

.boutique-password-modal__field input {
  width: 100%;

  box-sizing: border-box;

  padding:
    14px
    0;

  border: 0;

  border-bottom:
    1px solid var(--password-border);

  border-radius: 0;

  background: transparent;

  color: inherit;

  font: inherit;

  
}

.boutique-password-modal__submit {
  width: 100%;

  min-height: 52px;

  border:
    1px solid var(--password-button-bg);

  background:
    var(--password-button-bg);

  color:
    var(--password-button-text);

  font-size: 9px;

  font-weight: 600;

  letter-spacing: 0.15em;

  cursor: pointer;
}


/* VISUALLY HIDDEN */

.boutique-password .visually-hidden {
  position: absolute !important;

  width: 1px !important;
  height: 1px !important;

  padding: 0 !important;
  margin: -1px !important;

  overflow: hidden !important;

  clip: rect(0, 0, 0, 0) !important;

  white-space: nowrap !important;

  border: 0 !important;
}


/* MOBILE */

@media screen and (max-width: 650px) {

  .boutique-password__inner {
    padding:
      25px
      20px;
  }

  .boutique-password__content {
    padding:
      65px
      0;
  }

  .boutique-password__content h1 {
    font-size:
      clamp(55px, 18vw, 78px);
  }

  .boutique-password__newsletter-form {
    grid-template-columns: 1fr;
  }

  .boutique-password__newsletter-form button {
    min-height: 45px;

    padding: 0;

    text-align: left;
  }

  .boutique-password__bottom {
    flex-direction: column;

    align-items: flex-start;
  }

  .boutique-password-modal__panel {
    width: 100%;

    padding:
      70px
      25px;
  }

}

{% endstylesheet %}


<script>
document.addEventListener('DOMContentLoaded', function () {
  const modal = document.querySelector('[data-password-modal]');
  const openButton = document.querySelector('[data-password-open]');
  const closeButtons = document.querySelectorAll('[data-password-close]');

  if (!modal || !openButton) return;

  function openPasswordModal() {
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');

    document.body.style.overflow = 'hidden';

    const input = modal.querySelector('input[type="password"]');

    if (input) {
      setTimeout(function () {
        input.focus();
      }, 100);
    }
  }

  function closePasswordModal() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');

    document.body.style.overflow = '';
  }

  openButton.addEventListener('click', openPasswordModal);

  closeButtons.forEach(function (button) {
    button.addEventListener('click', closePasswordModal);
  });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') {
      closePasswordModal();
    }
  });
});
</script>


