<section
  class="
    boutique-campaign
    boutique-campaign--{{ section.settings.content_position }}
    boutique-campaign--text-{{ section.settings.text_alignment }}
  "
  style="
    --campaign-height: {{ section.settings.desktop_height }}px;
    --campaign-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --campaign-text: {{ section.settings.text_color }};
  "
>

  <div class="boutique-campaign__media">

    {% if section.settings.image != blank %}

      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          widths: '800, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          class: 'boutique-campaign__image'
      }}

    {% else %}

      {{ 'lifestyle-1' | placeholder_svg_tag }}

    {% endif %}

  </div>


  <div class="boutique-campaign__overlay"></div>


  <div class="boutique-campaign__content">

    <div class="boutique-campaign__content-inner">

      {% if section.settings.eyebrow != blank %}
        <p class="boutique-campaign__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}


      {% if section.settings.heading != blank %}
        <h2>
          {{ section.settings.heading }}
        </h2>
      {% endif %}


      {% if section.settings.description != blank %}
        <div class="boutique-campaign__description">
          {{ section.settings.description }}
        </div>
      {% endif %}


      {% if section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="boutique-campaign__button"
        >
          {{ section.settings.button_text }}
        </a>
      {% endif %}

    </div>

  </div>

</section>


{% stylesheet %}

/* =========================================
   CAMPAIGN WRAPPER
========================================= */

.boutique-campaign {
  position: relative;

  width: 100%;

  min-height: var(--campaign-height);

  overflow: hidden;

  color: var(--campaign-text);
}


/* =========================================
   IMAGE
========================================= */

.boutique-campaign__media {
  position: absolute;

  inset: 0;
}

.boutique-campaign__image,
.boutique-campaign__media svg {
  width: 100%;
  height: 100%;

  object-fit: cover;

  display: block;
}

.boutique-campaign__image {
  transition: transform 1.2s ease;
}

.boutique-campaign:hover
.boutique-campaign__image {
  transform: scale(1.015);
}


/* =========================================
   OVERLAY
========================================= */

.boutique-campaign__overlay {
  position: absolute;

  inset: 0;

  background: rgba(
    0,
    0,
    0,
    var(--campaign-overlay)
  );

  z-index: 1;
}


/* =========================================
   CONTENT
========================================= */

.boutique-campaign__content {
  position: relative;

  z-index: 2;

  min-height: var(--campaign-height);

  width: min(calc(100% - 60px), 1500px);

  margin: 0 auto;

  display: flex;

  padding-top: 70px;
  padding-bottom: 70px;
}


/* VERTICAL + HORIZONTAL POSITIONS */

.boutique-campaign--top-left
.boutique-campaign__content {
  align-items: flex-start;
  justify-content: flex-start;
}

.boutique-campaign--top-center
.boutique-campaign__content {
  align-items: flex-start;
  justify-content: center;
}

.boutique-campaign--top-right
.boutique-campaign__content {
  align-items: flex-start;
  justify-content: flex-end;
}

.boutique-campaign--center-left
.boutique-campaign__content {
  align-items: center;
  justify-content: flex-start;
}

.boutique-campaign--center-center
.boutique-campaign__content {
  align-items: center;
  justify-content: center;
}

.boutique-campaign--center-right
.boutique-campaign__content {
  align-items: center;
  justify-content: flex-end;
}

.boutique-campaign--bottom-left
.boutique-campaign__content {
  align-items: flex-end;
  justify-content: flex-start;
}

.boutique-campaign--bottom-center
.boutique-campaign__content {
  align-items: flex-end;
  justify-content: center;
}

.boutique-campaign--bottom-right
.boutique-campaign__content {
  align-items: flex-end;
  justify-content: flex-end;
}


/* =========================================
   CONTENT INNER
========================================= */

.boutique-campaign__content-inner {
  max-width: 620px;
}


/* TEXT ALIGNMENT */

.boutique-campaign--text-left
.boutique-campaign__content-inner {
  text-align: left;
}

.boutique-campaign--text-center
.boutique-campaign__content-inner {
  text-align: center;
}

.boutique-campaign--text-right
.boutique-campaign__content-inner {
  text-align: right;
}


/* =========================================
   TYPOGRAPHY
========================================= */

.boutique-campaign__eyebrow {
  margin: 0 0 18px;

  font-size: 10px;
  font-weight: 600;

  letter-spacing: 0.24em;

  text-transform: uppercase;
}

.boutique-campaign h2 {
  margin: 0;

  font-family: var(--font-heading-family);

  font-size: clamp(52px, 6vw, 92px);

  line-height: 0.95;

  font-weight: 400;

  letter-spacing: -0.025em;
}

.boutique-campaign__description {
  max-width: 500px;

  margin-top: 24px;

  font-size: 14px;

  line-height: 1.7;
}

.boutique-campaign--text-center
.boutique-campaign__description {
  margin-left: auto;
  margin-right: auto;
}

.boutique-campaign--text-right
.boutique-campaign__description {
  margin-left: auto;
}

.boutique-campaign__description p {
  margin: 0;
}


/* =========================================
   BUTTON
========================================= */

.boutique-campaign__button {
  min-height: 48px;

  margin-top: 31px;

  padding: 0 27px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  border: 1px solid currentColor;

  color: inherit;

  text-decoration: none;

  font-size: 10px;
  font-weight: 600;

  letter-spacing: 0.16em;

  text-transform: uppercase;

  transition:
    background 0.25s ease,
    color 0.25s ease;
}

.boutique-campaign__button:hover {
  background: var(--campaign-text);
  color: #111111;
}


/* =========================================
   MOBILE
========================================= */

@media screen and (max-width: 767px) {

  .boutique-campaign {
    min-height: 580px;
  }

  .boutique-campaign__content {
    min-height: 580px;

    width: calc(100% - 40px);

    padding-top: 45px;
    padding-bottom: 45px;

    align-items: flex-end !important;
    justify-content: flex-start !important;
  }

  .boutique-campaign__content-inner {
    max-width: 100%;

    text-align: left !important;
  }

  .boutique-campaign h2 {
    font-size: clamp(45px, 14vw, 65px);
  }

  .boutique-campaign__description {
    margin-left: 0;
    margin-right: 0;

    font-size: 13px;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Campaign banner",

  "settings": [

    {
      "type": "header",
      "content": "Image"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Campaign image"
    },


    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "NEW SEASON"
    },

    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The Autumn Edit"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Soft layers, considered textures and effortless silhouettes for the season ahead.</p>"
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "EXPLORE THE COLLECTION"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-center",
          "label": "Top center"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "center-left",
          "label": "Center left"
        },
        {
          "value": "center-center",
          "label": "Center"
        },
        {
          "value": "center-right",
          "label": "Center right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ],
      "default": "center-left"
    },

    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },

    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 450,
      "max": 900,
      "step": 25,
      "unit": "px",
      "default": 650
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }

  ],

  "presets": [
    {
      "name": "Campaign banner"
    }
  ]
}
{% endschema %}
