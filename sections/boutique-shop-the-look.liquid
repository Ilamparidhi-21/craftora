<section
  class="boutique-look"
  style="
    --look-bg: {{ section.settings.background_color }};
    --look-text: {{ section.settings.text_color }};
  "
>
  <div class="boutique-look__inner">

    <div class="boutique-look__media">

      {% if section.settings.image != blank %}

        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            loading: 'lazy',
            widths: '600, 900, 1200, 1500, 1800',
            sizes: '(min-width: 768px) 55vw, 100vw',
            class: 'boutique-look__image'
        }}

      {% else %}

        {{ 'lifestyle-1' | placeholder_svg_tag }}

      {% endif %}

    </div>


    <div class="boutique-look__content">

      {% if section.settings.eyebrow != blank %}
        <p class="boutique-look__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}


      {% if section.settings.heading != blank %}
        <h2>
          {{ section.settings.heading }}
        </h2>
      {% endif %}


      {% if section.settings.description != blank %}
        <div class="boutique-look__description">
          {{ section.settings.description }}
        </div>
      {% endif %}


      <div class="boutique-look__products">

        {% for block in section.blocks %}

          {% assign product = block.settings.product %}

          {% if product != blank %}

            <article
              class="boutique-look-product"
              {{ block.shopify_attributes }}
            >

              <a
                href="{{ product.url }}"
                class="boutique-look-product__image"
              >

                {% if product.featured_image != blank %}

                  {{
                    product.featured_image
                    | image_url: width: 700
                    | image_tag:
                      loading: 'lazy',
                      widths: '250, 400, 550, 700',
                      sizes: '(min-width: 768px) 180px, 40vw'
                  }}

                {% endif %}

              </a>


              <div class="boutique-look-product__info">

                {% if block.settings.label != blank %}
                  <span class="boutique-look-product__label">
                    {{ block.settings.label }}
                  </span>
                {% endif %}


                <a
                  href="{{ product.url }}"
                  class="boutique-look-product__title"
                >
                  {{ product.title }}
                </a>


                <div class="boutique-look-product__price">

                  {% if product.compare_at_price > product.price %}

                    <span>
                      {{ product.price | money }}
                    </span>

                    <s>
                      {{ product.compare_at_price | money }}
                    </s>

                  {% else %}

                    {{ product.price | money }}

                  {% endif %}

                </div>


                <a
                  href="{{ product.url }}"
                  class="boutique-look-product__button"
                >
                  VIEW PRODUCT
                </a>

              </div>

            </article>

          {% else %}

            <article
              class="boutique-look-product"
              {{ block.shopify_attributes }}
            >

              <div class="boutique-look-product__image">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>

              <div class="boutique-look-product__info">

                <span class="boutique-look-product__label">
                  {{ block.settings.label }}
                </span>

                <span class="boutique-look-product__title">
                  Example product
                </span>

                <div class="boutique-look-product__price">
                  {{ 199900 | money }}
                </div>

              </div>

            </article>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </div>
</section>


{% stylesheet %}

.boutique-look {
  width: 100%;

  background: var(--look-bg);
  color: var(--look-text);
}

.boutique-look__inner {
  display: grid;

  grid-template-columns:
    minmax(0, 56%)
    minmax(0, 44%);
}


/* IMAGE */

.boutique-look__media {
  min-height: 680px;

  position: relative;

  overflow: hidden;
}

.boutique-look__media img,
.boutique-look__media svg {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;
}


/* CONTENT */

.boutique-look__content {
  padding:
    clamp(55px, 6vw, 100px)
    clamp(35px, 5vw, 80px);

  display: flex;
  flex-direction: column;

  justify-content: center;
}

.boutique-look__eyebrow {
  margin: 0 0 17px;

  font-size: 10px;
  font-weight: 600;

  letter-spacing: 0.22em;

  text-transform: uppercase;
}

.boutique-look__content h2 {
  margin: 0;

  max-width: 500px;

  font-family: var(--font-heading-family);

  font-size: clamp(40px, 4vw, 62px);

  line-height: 1;

  font-weight: 400;
}

.boutique-look__description {
  max-width: 500px;

  margin-top: 20px;

  font-size: 14px;
  line-height: 1.7;

  opacity: 0.7;
}

.boutique-look__description p {
  margin: 0;
}


/* PRODUCTS */

.boutique-look__products {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 25px;

  margin-top: 38px;
}

.boutique-look-product {
  min-width: 0;
}

.boutique-look-product__image {
  display: block;

  aspect-ratio: 3 / 4;

  overflow: hidden;

  background: #ece8e2;
}

.boutique-look-product__image img,
.boutique-look-product__image svg {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  transition: transform 0.4s ease;
}

.boutique-look-product:hover
.boutique-look-product__image img {
  transform: scale(1.025);
}


/* PRODUCT TEXT */

.boutique-look-product__info {
  padding-top: 12px;
}

.boutique-look-product__label {
  display: block;

  margin-bottom: 5px;

  font-size: 9px;

  letter-spacing: 0.14em;

  text-transform: uppercase;

  opacity: 0.55;
}

.boutique-look-product__title {
  color: inherit;

  text-decoration: none;

  font-family: var(--font-heading-family);

  font-size: 15px;
}

.boutique-look-product__price {
  display: flex;

  gap: 8px;

  margin-top: 6px;

  font-size: 12px;
}

.boutique-look-product__price s {
  opacity: 0.45;
}

.boutique-look-product__button {
  display: inline-block;

  margin-top: 10px;

  color: inherit;

  text-decoration: none;

  border-bottom: 1px solid currentColor;

  padding-bottom: 3px;

  font-size: 9px;
  font-weight: 600;

  letter-spacing: 0.14em;

  text-transform: uppercase;
}


/* TABLET */

@media screen and (max-width: 900px) {

  .boutique-look__inner {
    grid-template-columns: 50% 50%;
  }

  .boutique-look__content {
    padding: 45px 30px;
  }

}


/* MOBILE */

@media screen and (max-width: 767px) {

  .boutique-look__inner {
    grid-template-columns: 1fr;
  }

  .boutique-look__media {
    min-height: 0;

    height: clamp(420px, 125vw, 520px);
  }

  .boutique-look__content {
    padding: 45px 20px 55px;
  }

  .boutique-look__products {
    gap: 12px;
  }

}


/* SMALL MOBILE */

@media screen and (max-width: 420px) {

  .boutique-look__media {
    min-height: 0;

    height: 430px;
  }

  .boutique-look__content h2 {
    font-size: 40px;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Shop the look",

  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "SHOP THE LOOK"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Styled Together"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Complete the look with pieces designed to work beautifully together.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F2EEE8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#171717"
    }
  ],

  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Small label",
          "default": "COMPLETE THE LOOK"
        }
      ]
    }
  ],

  "max_blocks": 4,

  "presets": [
    {
      "name": "Shop the look",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
