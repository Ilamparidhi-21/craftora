<section
  class="boutique-new-arrivals"
  style="
    --na-bg: {{ section.settings.background_color }};
    --na-text: {{ section.settings.text_color }};
  "
>
  <div class="boutique-new-arrivals__inner">

    <div class="boutique-new-arrivals__header">
      <div>
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      {% if section.settings.collection != blank %}
        <a href="{{ section.settings.collection.url }}">
          {{ section.settings.view_all_text }}
          →
        </a>
      {% endif %}
    </div>


    {% if section.settings.collection != blank %}

      <div class="boutique-products-grid">

        {% for product in section.settings.collection.products
          limit: section.settings.products_to_show
        %}

          <article class="boutique-product-card">

            <a
              href="{{ product.url }}"
              class="boutique-product-card__media"
            >

              {% if product.featured_image != blank %}

                {% assign product_image_alt = product.featured_image.alt | default: product.title %}

                {{
                  product.featured_image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 500, 700, 1000',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    alt: product_image_alt
                }}

              {% else %}

                {{ 'product-1' | placeholder_svg_tag }}

              {% endif %}


              {% if product.compare_at_price > product.price %}

                <span class="boutique-product-badge">
                  SALE
                </span>

              {% elsif forloop.index <= 4 %}

                <span class="boutique-product-badge">
                  NEW
                </span>

              {% endif %}

            </a>


            <div class="boutique-product-card__info">

              <div class="boutique-product-card__title-row">

                <a href="{{ product.url }}">
                  {{ product.title }}
                </a>

                <span class="boutique-product-heart">
                  ♡
                </span>

              </div>


              <div class="boutique-product-card__price">

                {% if product.compare_at_price > product.price %}

                  <span class="boutique-product-card__sale-price">
                    {{ product.price | money }}
                  </span>

                  <s>
                    {{ product.compare_at_price | money }}
                  </s>

                {% else %}

                  <span>
                    {{ product.price | money }}
                  </span>

                {% endif %}

              </div>


              {% if section.settings.show_vendor %}
                <div class="boutique-product-card__vendor">
                  {{ product.vendor }}
                </div>
              {% endif %}

            </div>

          </article>

        {% endfor %}

      </div>

    {% else %}

      <div class="boutique-products-grid">

        {% for i in (1..4) %}

          <article class="boutique-product-card">

            <div class="boutique-product-card__media">
              {{ 'product-1' | placeholder_svg_tag }}

              <span class="boutique-product-badge">
                NEW
              </span>
            </div>

            <div class="boutique-product-card__info">

              <div class="boutique-product-card__title-row">
                <span>Example product</span>
                <span>♡</span>
              </div>

              <div class="boutique-product-card__price">
                {{ 199900 | money }}
              </div>

            </div>

          </article>

        {% endfor %}

      </div>

    {% endif %}

  </div>
</section>


{% stylesheet %}

.boutique-new-arrivals {
  width: 100%;
  background: var(--na-bg);
  color: var(--na-text);

  padding: 70px 25px;
}

.boutique-new-arrivals__inner {
  width: min(100%, 1500px);
  margin: 0 auto;
}


/* HEADER */

.boutique-new-arrivals__header {
  display: flex;
  justify-content: space-between;
  align-items: end;

  gap: 25px;

  margin-bottom: 32px;
}

.boutique-new-arrivals__header h2 {
  margin: 0;

  font-family: var(--font-heading-family);

  font-size: clamp(30px, 3vw, 42px);

  font-weight: 400;

  letter-spacing: 0.08em;

  text-transform: uppercase;
}

.boutique-new-arrivals__header p {
  margin: 9px 0 0;

  font-size: 13px;

  opacity: 0.65;
}

.boutique-new-arrivals__header > a {
  color: inherit;

  text-decoration: none;

  font-size: 10px;
  font-weight: 600;

  letter-spacing: 0.14em;

  text-transform: uppercase;

  white-space: nowrap;
}


/* GRID */

.boutique-products-grid {
  display: grid;

  grid-template-columns: repeat(4, minmax(0, 1fr));

  gap: 18px;
}


/* PRODUCT */

.boutique-product-card {
  min-width: 0;
}

.boutique-product-card__media {
  position: relative;

  display: block;

  aspect-ratio: 3 / 4;

  overflow: hidden;

  background: #eeeae5;

  color: inherit;
}

.boutique-product-card__media img,
.boutique-product-card__media svg {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  transition: transform 0.5s ease;
}

.boutique-product-card:hover
.boutique-product-card__media img {
  transform: scale(1.025);
}


/* BADGE */

.boutique-product-badge {
  position: absolute;

  top: 12px;
  left: 12px;

  padding: 6px 8px;

  background: #ffffff;
  color: #111111;

  font-size: 9px;
  font-weight: 600;

  letter-spacing: 0.1em;
}


/* INFO */

.boutique-product-card__info {
  padding-top: 13px;
}

.boutique-product-card__title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 10px;
}

.boutique-product-card__title-row a {
  color: inherit;

  text-decoration: none;

  font-family: var(--font-heading-family);

  font-size: 15px;
}

.boutique-product-heart {
  font-size: 20px;

  line-height: 1;
}

.boutique-product-card__price {
  display: flex;

  gap: 8px;

  margin-top: 7px;

  font-size: 13px;
}

.boutique-product-card__sale-price {
  color: #a43b32;
}

.boutique-product-card__price s {
  opacity: 0.5;
}

.boutique-product-card__vendor {
  margin-top: 5px;

  font-size: 10px;

  letter-spacing: 0.1em;

  text-transform: uppercase;

  opacity: 0.5;
}


/* TABLET */

@media screen and (max-width: 950px) {

  .boutique-products-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

}


/* MOBILE */

@media screen and (max-width: 550px) {

  .boutique-new-arrivals {
    padding: 50px 15px;
  }

  .boutique-new-arrivals__header {
    align-items: flex-start;

    flex-direction: column;

    margin-bottom: 25px;
  }

  .boutique-products-grid {
    gap: 10px;
  }

  .boutique-product-card__title-row a {
    font-size: 13px;
  }

  .boutique-product-card__price {
    font-size: 12px;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "New arrivals",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW ARRIVALS"
    },

    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover the latest pieces in our boutique."
    },

    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },

    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 4
    },

    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "VIEW ALL"
    },

    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#171717"
    }
  ],

  "presets": [
    {
      "name": "New arrivals"
    }
  ]
}
{% endschema %}
