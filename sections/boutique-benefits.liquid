<section
  class="boutique-benefits"
  style="
    --benefit-bg: {{ section.settings.background_color }};
    --benefit-text: {{ section.settings.text_color }};
    --benefit-border: {{ section.settings.border_color }};
  "
>
  <div class="boutique-benefits__inner">

    {% for block in section.blocks %}

      <div
        class="boutique-benefit"
        {{ block.shopify_attributes }}
      >

        {% if block.settings.icon != 'none' %}
          <div class="boutique-benefit__icon">

            {% case block.settings.icon %}

              {% when 'shipping' %}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                >
                  <path d="M3 6h11v10H3z"></path>
                  <path d="M14 10h4l3 3v3h-7z"></path>
                  <circle cx="7" cy="18" r="2"></circle>
                  <circle cx="18" cy="18" r="2"></circle>
                </svg>

              {% when 'returns' %}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                >
                  <path d="M4 7v5h5"></path>
                  <path d="M5 11a8 8 0 1 0 2-5"></path>
                </svg>

              {% when 'secure' %}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                >
                  <rect x="5" y="10" width="14" height="10" rx="1"></rect>
                  <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                </svg>

              {% when 'support' %}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                >
                  <circle cx="12" cy="8" r="4"></circle>
                  <path d="M4 21c1-5 4-7 8-7s7 2 8 7"></path>
                </svg>

              {% when 'gift' %}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                >
                  <rect x="3" y="9" width="18" height="12"></rect>
                  <path d="M12 9v12"></path>
                  <path d="M3 13h18"></path>
                  <path d="M12 9H8.5A2.5 2.5 0 1 1 11 6.5Z"></path>
                  <path d="M12 9h3.5A2.5 2.5 0 1 0 13 6.5Z"></path>
                </svg>

            {% endcase %}

          </div>
        {% endif %}


        <div class="boutique-benefit__content">

          {% if block.settings.heading != blank %}
            <h3>
              {{ block.settings.heading }}
            </h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p>
              {{ block.settings.text }}
            </p>
          {% endif %}

        </div>

      </div>

    {% endfor %}

  </div>
</section>


{% stylesheet %}

.boutique-benefits {
  width: 100%;

  background: var(--benefit-bg);
  color: var(--benefit-text);

  border-top:
    1px solid var(--benefit-border);

  border-bottom:
    1px solid var(--benefit-border);
}

.boutique-benefits__inner {
  width: min(100%, 1500px);

  margin: 0 auto;

  padding: 30px 25px;

  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));
}


/* INDIVIDUAL BENEFIT */

.boutique-benefit {
  min-height: 80px;

  padding: 0 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 17px;

  border-right:
    1px solid var(--benefit-border);
}

.boutique-benefit:first-child {
  padding-left: 0;
}

.boutique-benefit:last-child {
  padding-right: 0;

  border-right: 0;
}


/* ICON */

.boutique-benefit__icon {
  flex: 0 0 auto;

  display: flex;
  align-items: center;
  justify-content: center;
}

.boutique-benefit__icon svg {
  width: 28px;
  height: 28px;
}


/* TEXT */

.boutique-benefit__content h3 {
  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 15px;

  font-weight: 400;

  letter-spacing: 0.03em;
}

.boutique-benefit__content p {
  margin: 6px 0 0;

  font-size: 10px;

  line-height: 1.5;

  letter-spacing: 0.05em;

  opacity: 0.62;
}


/* TABLET */

@media screen and (max-width: 900px) {

  .boutique-benefits__inner {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    padding-top: 15px;
    padding-bottom: 15px;
  }

  .boutique-benefit {
    padding: 25px;

    border-bottom:
      1px solid var(--benefit-border);
  }

  .boutique-benefit:nth-child(2) {
    border-right: 0;
  }

  .boutique-benefit:nth-last-child(-n+2) {
    border-bottom: 0;
  }

  .boutique-benefit:first-child {
    padding-left: 25px;
  }

  .boutique-benefit:last-child {
    padding-right: 25px;
  }

}


/* MOBILE */

@media screen and (max-width: 550px) {

  .boutique-benefits__inner {
    grid-template-columns: 1fr;

    padding: 10px 20px;
  }

  .boutique-benefit {
    justify-content: flex-start;

    padding: 22px 0 !important;

    border-right: 0;

    border-bottom:
      1px solid var(--benefit-border);
  }

  .boutique-benefit:nth-last-child(-n+2) {
    border-bottom:
      1px solid var(--benefit-border);
  }

  .boutique-benefit:last-child {
    border-bottom: 0;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Boutique benefits",

  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F7F4EF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#DDD7CF"
    }
  ],

  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "shipping",
              "label": "Shipping"
            },
            {
              "value": "returns",
              "label": "Returns"
            },
            {
              "value": "secure",
              "label": "Secure checkout"
            },
            {
              "value": "support",
              "label": "Personal service"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "none",
              "label": "No icon"
            }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Complimentary Shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Available on qualifying orders."
        }
      ]
    }
  ],

  "max_blocks": 4,

  "presets": [
    {
      "name": "Boutique benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "shipping",
            "heading": "Complimentary Shipping",
            "text": "Available on qualifying orders."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "returns",
            "heading": "Easy Returns",
            "text": "Simple and convenient returns."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "secure",
            "heading": "Secure Checkout",
            "text": "Protected and trusted payments."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "support",
            "heading": "Personal Service",
            "text": "Here when you need assistance."
          }
        }
      ]
    }
  ]
}
{% endschema %}
