{% comment %}
  Boutique Blog / Journal Page
{% endcomment %}

<section
  class="boutique-blog"
  style="
    --blog-bg: {{ section.settings.background_color }};
    --blog-text: {{ section.settings.text_color }};
    --blog-border: {{ section.settings.border_color }};
    --blog-columns: {{ section.settings.columns_desktop }};
  "
>

  <div class="boutique-blog__inner">

    <header class="boutique-blog__header">

      {% if section.settings.eyebrow != blank %}
        <p class="boutique-blog__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <h1>{{ blog.title }}</h1>

      {% if section.settings.description != blank %}
        <div class="boutique-blog__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

    </header>


    {% paginate blog.articles by section.settings.articles_per_page %}

      {% assign article_offset = 0 %}

      {% if section.settings.show_featured_article and paginate.current_page == 1 %}

        {% assign article_offset = 1 %}

        {% for article in blog.articles limit: 1 %}

          <article class="boutique-blog-featured">

            <a
              href="{{ article.url }}"
              class="boutique-blog-featured__image"
            >

              {% if article.image %}

                {{
                  article.image
                  | image_url: width: 1800
                  | image_tag:
                    loading: 'eager',
                    widths: '700, 1000, 1400, 1800',
                    sizes: '(min-width: 900px) 60vw, 100vw'
                }}

              {% else %}

                {{ 'lifestyle-1' | placeholder_svg_tag }}

              {% endif %}

            </a>


            <div class="boutique-blog-featured__content">

              <p class="boutique-blog__meta">
                {{ article.published_at | date: "%B %d, %Y" }}

                {% if section.settings.show_author %}
                  <span>— {{ article.author }}</span>
                {% endif %}
              </p>

              <h2>
                <a href="{{ article.url }}">
                  {{ article.title }}
                </a>
              </h2>

              {% if section.settings.show_excerpt %}

                <div class="boutique-blog-featured__excerpt">

                  {% if article.excerpt != blank %}
                    {{ article.excerpt | strip_html | truncatewords: 35 }}
                  {% else %}
                    {{ article.content | strip_html | truncatewords: 35 }}
                  {% endif %}

                </div>

              {% endif %}

              <a
                href="{{ article.url }}"
                class="boutique-blog__read-more"
              >
                READ STORY →
              </a>

            </div>

          </article>

        {% endfor %}

      {% endif %}


      <div class="boutique-blog__grid">

        {% for article in blog.articles offset: article_offset %}

          <article class="boutique-blog-card">

            <a
              href="{{ article.url }}"
              class="boutique-blog-card__image"
            >

              {% if article.image %}

                {{
                  article.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 990px) 33vw, 50vw'
                }}

              {% else %}

                {{ 'lifestyle-2' | placeholder_svg_tag }}

              {% endif %}

            </a>


            <div class="boutique-blog-card__content">

              <p class="boutique-blog__meta">

                {{ article.published_at | date: "%B %d, %Y" }}

                {% if section.settings.show_author %}
                  <span>— {{ article.author }}</span>
                {% endif %}

              </p>

              <h2>
                <a href="{{ article.url }}">
                  {{ article.title }}
                </a>
              </h2>

              {% if section.settings.show_excerpt %}

                <p class="boutique-blog-card__excerpt">

                  {% if article.excerpt != blank %}
                    {{ article.excerpt | strip_html | truncatewords: 22 }}
                  {% else %}
                    {{ article.content | strip_html | truncatewords: 22 }}
                  {% endif %}

                </p>

              {% endif %}

              <a
                href="{{ article.url }}"
                class="boutique-blog__read-more"
              >
                READ MORE →
              </a>

            </div>

          </article>

        {% else %}

          <div class="boutique-blog__empty">
            <p>No stories have been published yet.</p>
          </div>

        {% endfor %}

      </div>


      {% if paginate.pages > 1 %}

        <nav
          class="boutique-blog-pagination"
          aria-label="Blog pagination"
        >

          <div>

            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}">
                ← PREVIOUS
              </a>
            {% endif %}

          </div>


          <div class="boutique-blog-pagination__pages">

            {% for part in paginate.parts %}

              {% if part.is_link %}

                <a href="{{ part.url }}">
                  {{ part.title }}
                </a>

              {% else %}

                <span
                  {% if part.title == paginate.current_page %}
                    class="active"
                  {% endif %}
                >
                  {{ part.title }}
                </span>

              {% endif %}

            {% endfor %}

          </div>


          <div class="boutique-blog-pagination__next">

            {% if paginate.next %}
              <a href="{{ paginate.next.url }}">
                NEXT →
              </a>
            {% endif %}

          </div>

        </nav>

      {% endif %}

    {% endpaginate %}

  </div>

</section>


{% stylesheet %}

.boutique-blog {
  padding: 70px 25px 100px;

  background: var(--blog-bg);
  color: var(--blog-text);
}

.boutique-blog__inner {
  width: min(100%, 1450px);

  margin: 0 auto;
}


/* HEADER */

.boutique-blog__header {
  max-width: 800px;

  margin:
    0
    auto
    65px;

  text-align: center;
}

.boutique-blog__eyebrow {
  margin: 0 0 15px;

  font-size: 9px;
  font-weight: 600;

  letter-spacing: 0.22em;

  text-transform: uppercase;
}

.boutique-blog__header h1 {
  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(50px, 7vw, 90px);

  line-height: 1;

  font-weight: 400;
}

.boutique-blog__description {
  max-width: 600px;

  margin:
    20px
    auto
    0;

  font-size: 14px;

  line-height: 1.7;

  opacity: 0.65;
}


/* FEATURED ARTICLE */

.boutique-blog-featured {
  display: grid;

  grid-template-columns:
    minmax(0, 1.35fr)
    minmax(0, 0.65fr);

  margin-bottom: 75px;

  background: #f4f0ea;
}

.boutique-blog-featured__image {
  position: relative;

  min-height: 620px;

  overflow: hidden;

  background: #e8e3dc;
}

.boutique-blog-featured__image img,
.boutique-blog-featured__image svg {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform
    0.7s ease;
}

.boutique-blog-featured:hover
.boutique-blog-featured__image img {
  transform: scale(1.025);
}

.boutique-blog-featured__content {
  padding:
    clamp(40px, 6vw, 80px);

  display: flex;

  flex-direction: column;

  justify-content: center;
}

.boutique-blog-featured__content h2 {
  margin:
    15px
    0
    20px;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(38px, 4vw, 58px);

  line-height: 1.05;

  font-weight: 400;
}

.boutique-blog-featured__content h2 a {
  color: inherit;

  text-decoration: none;
}

.boutique-blog-featured__excerpt {
  font-size: 14px;

  line-height: 1.75;

  opacity: 0.68;
}


/* META */

.boutique-blog__meta {
  margin: 0;

  font-size: 8px;

  font-weight: 600;

  letter-spacing: 0.13em;

  text-transform: uppercase;

  opacity: 0.55;
}


/* GRID */

.boutique-blog__grid {
  display: grid;

  grid-template-columns:
    repeat(
      var(--blog-columns),
      minmax(0, 1fr)
    );

  gap:
    55px
    22px;
}


/* ARTICLE CARD */

.boutique-blog-card__image {
  position: relative;

  display: block;

  aspect-ratio: 4 / 5;

  overflow: hidden;

  background: #e8e3dc;
}

.boutique-blog-card__image img,
.boutique-blog-card__image svg {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  transition:
    transform
    0.6s ease;
}

.boutique-blog-card:hover
.boutique-blog-card__image img {
  transform: scale(1.035);
}

.boutique-blog-card__content {
  padding-top: 20px;
}

.boutique-blog-card h2 {
  margin:
    12px
    0
    13px;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(25px, 2.5vw, 35px);

  line-height: 1.1;

  font-weight: 400;
}

.boutique-blog-card h2 a {
  color: inherit;

  text-decoration: none;
}

.boutique-blog-card__excerpt {
  margin: 0;

  font-size: 13px;

  line-height: 1.7;

  opacity: 0.65;
}


/* READ MORE */

.boutique-blog__read-more {
  display: inline-block;

  margin-top: 20px;

  padding-bottom: 4px;

  border-bottom:
    1px solid currentColor;

  color: inherit;

  text-decoration: none;

  font-size: 8px;

  font-weight: 600;

  letter-spacing: 0.15em;
}


/* PAGINATION */

.boutique-blog-pagination {
  display: grid;

  grid-template-columns:
    1fr
    auto
    1fr;

  align-items: center;

  margin-top: 75px;

  padding-top: 25px;

  border-top:
    1px solid var(--blog-border);
}

.boutique-blog-pagination a {
  color: inherit;

  text-decoration: none;

  font-size: 9px;

  letter-spacing: 0.12em;
}

.boutique-blog-pagination__pages {
  display: flex;

  gap: 15px;
}

.boutique-blog-pagination__pages a,
.boutique-blog-pagination__pages span {
  font-size: 11px;

  opacity: 0.45;
}

.boutique-blog-pagination__pages .active {
  opacity: 1;

  border-bottom:
    1px solid currentColor;
}

.boutique-blog-pagination__next {
  text-align: right;
}


/* EMPTY */

.boutique-blog__empty {
  grid-column: 1 / -1;

  padding: 60px;

  border:
    1px solid var(--blog-border);

  text-align: center;

  opacity: 0.6;
}


/* TABLET */

@media screen and (max-width: 950px) {

  .boutique-blog-featured {
    grid-template-columns: 1fr 1fr;
  }

  .boutique-blog-featured__image {
    min-height: 520px;
  }

  .boutique-blog__grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

}


/* MOBILE */

@media screen and (max-width: 650px) {

  .boutique-blog {
    padding:
      50px
      16px
      70px;
  }

  .boutique-blog__header {
    margin-bottom: 40px;
  }

  .boutique-blog__header h1 {
    font-size: 50px;
  }

  .boutique-blog-featured {
    grid-template-columns: 1fr;

    margin-bottom: 55px;
  }

  .boutique-blog-featured__image {
    min-height: 460px;
  }

  .boutique-blog-featured__content {
    padding:
      35px
      25px
      40px;
  }

  .boutique-blog__grid {
    grid-template-columns: 1fr;

    gap: 45px;
  }

  .boutique-blog-pagination__pages {
    gap: 8px;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Boutique blog",

  "settings": [

    {
      "type": "header",
      "content": "Heading"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "THE JOURNAL"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Stories, style inspiration and considered notes from our world.</p>"
    },

    {
      "type": "header",
      "content": "Articles"
    },

    {
      "type": "checkbox",
      "id": "show_featured_article",
      "label": "Feature first article",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },

    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },

    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 9
    },

    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#171717"
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#DDD8D1"
    }

  ]
}
{% endschema %}
