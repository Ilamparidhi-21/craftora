<section
  id="BoutiqueRecommendations-{{ section.id }}"
  class="boutique-related"
  data-product-recommendations
  data-recommendations-loaded="{% if recommendations.performed? %}true{% else %}false{% endif %}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related"
  style="
    --related-bg: {{ section.settings.background_color }};
    --related-text: {{ section.settings.text_color }};
  "
  {% unless recommendations.performed? %}
    hidden
  {% endunless %}
>

  {% if recommendations.performed? and recommendations.products_count > 0 %}

    <div class="boutique-related__inner">

      <div class="boutique-related__heading">

        {% if section.settings.eyebrow != blank %}
          <p>
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2>
            {{ section.settings.heading }}
          </h2>
        {% endif %}

      </div>


      <div class="boutique-related__grid">

        {% for related_product in recommendations.products %}

          <article class="boutique-related-card">

            <a
              href="{{ related_product.url }}"
              class="boutique-related-card__image"
            >

              {% if related_product.featured_image != blank %}

                {% assign related_image_alt = related_product.featured_image.alt | default: related_product.title %}

                {{
                  related_product.featured_image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 500, 700, 1000',
                    sizes: '(min-width: 900px) 25vw, 50vw',
                    alt: related_image_alt
                }}

              {% else %}

                {{ 'product-1' | placeholder_svg_tag }}

              {% endif %}


              {% unless related_product.available %}

                <span class="boutique-related-card__badge">
                  SOLD OUT
                </span>

              {% elsif related_product.compare_at_price > related_product.price %}

                <span class="boutique-related-card__badge">
                  SALE
                </span>

              {% endunless %}

            </a>


            <div class="boutique-related-card__info">

              <div class="boutique-related-card__title">

                <a href="{{ related_product.url }}">
                  {{ related_product.title }}
                </a>

                <span aria-hidden="true">
                  ♡
                </span>

              </div>


              <div class="boutique-related-card__price">

                {% if related_product.price_varies %}

                  From {{ related_product.price_min | money }}

                {% elsif related_product.compare_at_price > related_product.price %}

                  <span class="boutique-related-card__sale">
                    {{ related_product.price | money }}
                  </span>

                  <s>
                    {{ related_product.compare_at_price | money }}
                  </s>

                {% else %}

                  {{ related_product.price | money }}

                {% endif %}

              </div>

            </div>

          </article>

        {% endfor %}

      </div>


      {% if section.settings.show_view_all %}

        <div class="boutique-related__view-all">

          <a href="{{ routes.all_products_collection_url }}">
            SHOP ALL →
          </a>

        </div>

      {% endif %}

    </div>

  {% endif %}

</section>


{% stylesheet %}

.boutique-related {
  width: 100%;

  padding:
    85px
    25px
    95px;

  background: var(--related-bg);
  color: var(--related-text);
}

.boutique-related__inner {
  width: min(100%, 1450px);

  margin: 0 auto;
}


/* HEADING */

.boutique-related__heading {
  text-align: center;

  margin-bottom: 40px;
}

.boutique-related__heading p {
  margin: 0 0 13px;

  font-size: 9px;
  font-weight: 600;

  letter-spacing: 0.2em;

  text-transform: uppercase;
}

.boutique-related__heading h2 {
  margin: 0;

  font-family: var(--font-heading-family);

  font-size: clamp(36px, 4vw, 52px);

  font-weight: 400;
}


/* GRID */

.boutique-related__grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 18px;
}


/* PRODUCT IMAGE */

.boutique-related-card__image {
  position: relative;

  display: block;

  aspect-ratio: 3 / 4;

  overflow: hidden;

  background: #eeeae5;
}

.boutique-related-card__image img,
.boutique-related-card__image svg {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  transition: transform 0.5s ease;
}

.boutique-related-card:hover
.boutique-related-card__image img {
  transform: scale(1.025);
}


/* BADGE */

.boutique-related-card__badge {
  position: absolute;

  top: 12px;
  left: 12px;

  padding: 6px 9px;

  background: #ffffff;
  color: #111111;

  font-size: 8px;
  font-weight: 600;

  letter-spacing: 0.12em;
}


/* INFO */

.boutique-related-card__info {
  padding-top: 13px;
}

.boutique-related-card__title {
  display: flex;

  justify-content: space-between;

  gap: 12px;
}

.boutique-related-card__title a {
  color: inherit;

  text-decoration: none;

  font-family: var(--font-heading-family);

  font-size: 15px;
}

.boutique-related-card__title span:last-child {
  font-size: 18px;
}

.boutique-related-card__price {
  margin-top: 7px;

  display: flex;

  gap: 8px;

  font-size: 12px;
}

.boutique-related-card__sale {
  color: #9b3a32;
}

.boutique-related-card__price s {
  opacity: 0.45;
}


/* VIEW ALL */

.boutique-related__view-all {
  margin-top: 40px;

  text-align: center;
}

.boutique-related__view-all a {
  color: inherit;

  text-decoration: none;

  padding-bottom: 5px;

  border-bottom:
    1px solid currentColor;

  font-size: 9px;
  font-weight: 600;

  letter-spacing: 0.15em;
}


/* TABLET */

@media screen and (max-width: 900px) {

  .boutique-related__grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

}


/* MOBILE */

@media screen and (max-width: 550px) {

  .boutique-related {
    padding:
      60px
      10px
      70px;
  }

  .boutique-related__heading {
    margin-bottom: 30px;
  }

  .boutique-related__grid {
    gap:
      30px
      10px;
  }

  .boutique-related-card__title a {
    font-size: 13px;
  }

}

{% endstylesheet %}



<script>
(function () {

  function initBoutiqueRecommendations(root) {

    const selector =
      '#BoutiqueRecommendations-{{ section.id }}';

    let sectionElement = null;


    if (
      root &&
      root.matches &&
      root.matches(selector)
    ) {

      sectionElement = root;

    } else if (
      root &&
      root.querySelector
    ) {

      sectionElement =
        root.querySelector(selector);

    }


    if (!sectionElement) return;


    if (
      sectionElement.dataset.recommendationsLoaded ===
      'true'
    ) {
      return;
    }


    if (
      sectionElement.dataset.boutiqueRecommendationsInitialized ===
      'true'
    ) {
      return;
    }


    sectionElement.dataset.boutiqueRecommendationsInitialized =
      'true';


    const url =
      sectionElement.dataset.url;


    if (!url) {
      sectionElement.remove();
      return;
    }


    fetch(url)
      .then(function (response) {

        if (!response.ok) {
          throw new Error(
            'Unable to load product recommendations'
          );
        }

        return response.text();

      })
      .then(function (htmlText) {

        const container =
          document.createElement('div');

        container.innerHTML =
          htmlText;


        const recommendationsSection =
          container.querySelector(selector);


        if (
          !recommendationsSection ||
          recommendationsSection.dataset.recommendationsLoaded !==
            'true'
        ) {

          sectionElement.remove();

          return;

        }


        const productCards =
          recommendationsSection.querySelectorAll(
            '.boutique-related-card'
          );


        if (!productCards.length) {

          sectionElement.remove();

          return;

        }


        sectionElement.replaceWith(
          recommendationsSection
        );

      })
      .catch(function () {

        /*
         * Recommendation failure shouldn't prevent
         * the rest of the product page from working.
         */

        sectionElement.remove();

      });

  }


  function bootBoutiqueRecommendations(root) {

    initBoutiqueRecommendations(
      root || document
    );

  }


  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      function () {

        bootBoutiqueRecommendations(
          document
        );

      },
      { once: true }
    );

  } else {

    bootBoutiqueRecommendations(
      document
    );

  }


  const handlerKey =
    'BoutiqueRecommendationsSectionLoad-{{ section.id }}';


  if (window[handlerKey]) {

    document.removeEventListener(
      'shopify:section:load',
      window[handlerKey]
    );

  }


  window[handlerKey] =
    function (event) {

      bootBoutiqueRecommendations(
        event.target
      );

    };


  document.addEventListener(
    'shopify:section:load',
    window[handlerKey]
  );

})();
</script>


{% schema %}
{
  "name": "Related products",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "COMPLETE YOUR WARDROBE"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },

    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },

    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show shop all link",
      "default": true
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F7F4EF"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#171717"
    }

  ],

  "presets": [
    {
      "name": "Related products"
    }
  ]
}
{% endschema %}
