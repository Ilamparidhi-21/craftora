<section
  class="boutique-newsletter"
  style="
    --newsletter-bg: {{ section.settings.background_color }};
    --newsletter-text: {{ section.settings.text_color }};
    --newsletter-border: {{ section.settings.border_color }};
  "
>
  <div class="boutique-newsletter__inner">

    <div class="boutique-newsletter__content">

      {% if section.settings.eyebrow != blank %}
        <p class="boutique-newsletter__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="boutique-newsletter__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

    </div>


    <div class="boutique-newsletter__form">

      {% form 'customer' %}

        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter"
        >

        <div class="boutique-newsletter__field">

          <input
            type="email"
            name="contact[email]"
            value="{% if customer %}{{ customer.email }}{% endif %}"
            placeholder="{{ section.settings.placeholder }}"
            aria-label="{{ section.settings.placeholder }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            required
          >

          <button type="submit">
            {{ section.settings.button_text }}

            <span aria-hidden="true">
              →
            </span>
          </button>

        </div>


        {% if form.posted_successfully? %}

          <p class="boutique-newsletter__success">
            {{ section.settings.success_text }}
          </p>

        {% endif %}


        {% if form.errors %}

          <div class="boutique-newsletter__error">
            {{ form.errors | default_errors }}
          </div>

        {% endif %}

      {% endform %}


      {% if section.settings.small_text != blank %}
        <p class="boutique-newsletter__small">
          {{ section.settings.small_text }}
        </p>
      {% endif %}

    </div>

  </div>
</section>


{% stylesheet %}

.boutique-newsletter {
  width: 100%;

  background: var(--newsletter-bg);
  color: var(--newsletter-text);

  padding: 85px 25px;
}

.boutique-newsletter__inner {
  width: min(100%, 1350px);

  margin: 0 auto;

  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(350px, 0.8fr);

  gap: 100px;

  align-items: center;
}


/* CONTENT */

.boutique-newsletter__eyebrow {
  margin: 0 0 16px;

  font-size: 10px;
  font-weight: 600;

  letter-spacing: 0.22em;

  text-transform: uppercase;
}

.boutique-newsletter__content h2 {
  max-width: 700px;

  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: clamp(42px, 5vw, 68px);

  line-height: 1;

  font-weight: 400;
}

.boutique-newsletter__description {
  max-width: 560px;

  margin-top: 20px;

  font-size: 14px;

  line-height: 1.7;

  opacity: 0.7;
}

.boutique-newsletter__description p {
  margin: 0;
}


/* FORM */

.boutique-newsletter__form {
  width: 100%;
}

.boutique-newsletter__field {
  width: 100%;

  display: flex;

  align-items: stretch;

  border-bottom:
    1px solid var(--newsletter-border);
}

.boutique-newsletter__field input {
  flex: 1;

  min-width: 0;

  padding: 16px 0;

  background: transparent;

  border: 0;
  outline: 0;

  color: inherit;

  font-size: 14px;
}

.boutique-newsletter__field input::placeholder {
  color: inherit;

  opacity: 0.55;
}

.boutique-newsletter__field button {
  padding: 0 0 0 25px;

  display: flex;

  align-items: center;

  gap: 14px;

  background: transparent;

  border: 0;

  color: inherit;

  cursor: pointer;

  font-size: 10px;
  font-weight: 600;

  letter-spacing: 0.15em;

  text-transform: uppercase;
}

.boutique-newsletter__field button span {
  font-size: 17px;

  transition: transform 0.2s ease;
}

.boutique-newsletter__field button:hover span {
  transform: translateX(4px);
}


/* MESSAGES */

.boutique-newsletter__success {
  margin: 14px 0 0;

  font-size: 12px;
}

.boutique-newsletter__error {
  margin-top: 14px;

  font-size: 12px;
}

.boutique-newsletter__small {
  margin: 14px 0 0;

  font-size: 10px;

  line-height: 1.5;

  opacity: 0.5;
}


/* TABLET */

@media screen and (max-width: 900px) {

  .boutique-newsletter__inner {
    grid-template-columns: 1fr;

    gap: 45px;
  }

}


/* MOBILE */

@media screen and (max-width: 550px) {

  .boutique-newsletter {
    padding: 60px 20px;
  }

  .boutique-newsletter__content h2 {
    font-size: 42px;
  }

  .boutique-newsletter__field button {
    padding-left: 12px;
  }

  .boutique-newsletter__field button span {
    display: none;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Boutique newsletter",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "STAY IN THE KNOW"
    },

    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "A Little Something For Your Inbox"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Be first to discover new arrivals, private edits and boutique stories.</p>"
    },

    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "JOIN US"
    },

    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thank you for joining us."
    },

    {
      "type": "text",
      "id": "small_text",
      "label": "Small text",
      "default": "By subscribing, you agree to receive marketing emails."
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#E7E0D6"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#171717"
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Input line",
      "default": "#8C857D"
    }

  ],

  "presets": [
    {
      "name": "Boutique newsletter"
    }
  ]
}
{% endschema %}
