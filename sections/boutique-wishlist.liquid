<section
  class="boutique-wishlist-page"
  data-wishlist-page
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
>
  <div class="boutique-wishlist-page__inner">

    <header class="boutique-wishlist-page__header">

      {% if section.settings.eyebrow != blank %}
        <p>
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <h1>
        {{ section.settings.heading }}
      </h1>

      {% if section.settings.description != blank %}
        <div class="boutique-wishlist-page__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

    </header>


    <p
      class="boutique-wishlist-page__loading"
      data-wishlist-loading
    >
      Loading your wishlist…
    </p>


    <div
      class="boutique-wishlist-page__empty"
      data-wishlist-empty
      hidden
    >

      <h2>
        {{ section.settings.empty_heading }}
      </h2>

      {% if section.settings.empty_text != blank %}
        <div>
          {{ section.settings.empty_text }}
        </div>
      {% endif %}

      <a
        href="{{ routes.all_products_collection_url }}"
        class="boutique-wishlist-page__continue"
      >
        {{ section.settings.continue_label }}
      </a>

    </div>


    <div
      class="boutique-wishlist-grid"
      data-wishlist-grid
      hidden
    ></div>

  </div>
</section>


{% stylesheet %}

.boutique-wishlist-page {
  width: 100%;

  padding:
    80px
    25px
    100px;
}

.boutique-wishlist-page__inner {
  width: min(100%, 1450px);

  margin: 0 auto;
}

.boutique-wishlist-page__header {
  max-width: 720px;

  margin:
    0 auto
    55px;

  text-align: center;
}

.boutique-wishlist-page__header > p {
  margin-bottom: 12px;

  font-size: 9px;
  font-weight: 600;

  letter-spacing: 0.2em;

  text-transform: uppercase;
}

.boutique-wishlist-page__header h1 {
  font-family:
    var(--font-heading-family);

  font-size:
    clamp(42px, 6vw, 72px);

  font-weight: 400;
}

.boutique-wishlist-page__description {
  margin-top: 18px;

  opacity: 0.7;
}

.boutique-wishlist-page__loading {
  text-align: center;
}

.boutique-wishlist-page__empty {
  max-width: 600px;

  margin: 80px auto;

  text-align: center;
}

.boutique-wishlist-page__empty h2 {
  font-family:
    var(--font-heading-family);

  font-size: 34px;

  font-weight: 400;
}

.boutique-wishlist-page__empty > div {
  margin-top: 15px;

  opacity: 0.7;
}

.boutique-wishlist-page__continue {
  display: inline-block;

  margin-top: 28px;

  padding-bottom: 5px;

  border-bottom:
    1px solid currentColor;

  color: inherit;

  font-size: 10px;
  font-weight: 600;

  letter-spacing: 0.15em;

  text-decoration: none;
}

.boutique-wishlist-grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 40px 18px;
}

.boutique-wishlist-card {
  min-width: 0;
}

.boutique-wishlist-card__media {
  display: block;

  aspect-ratio: 3 / 4;

  overflow: hidden;

  background: #eeeae5;
}

.boutique-wishlist-card__media img {
  width: 100%;
  height: 100%;

  object-fit: cover;
}

.boutique-wishlist-card__info {
  padding-top: 14px;
}

.boutique-wishlist-card__title {
  display: block;

  color: inherit;

  font-family:
    var(--font-heading-family);

  font-size: 15px;

  text-decoration: none;
}

.boutique-wishlist-card__price {
  margin-top: 7px;

  font-size: 12px;
}

.boutique-wishlist-card__actions {
  display: grid;

  grid-template-columns:
    1fr auto;

  gap: 8px;

  margin-top: 15px;
}

.boutique-wishlist-card__add,
.boutique-wishlist-card__remove {
  min-height: 42px;

  padding:
    10px
    14px;

  border:
    1px solid currentColor;

  background: transparent;

  color: inherit;

  cursor: pointer;

  font: inherit;

  font-size: 9px;
  font-weight: 600;

  letter-spacing: 0.12em;
}

.boutique-wishlist-card__add {
  background:
    var(--color-foreground);

  color:
    var(--color-background);
}

.boutique-wishlist-card__add:disabled {
  cursor: not-allowed;

  opacity: 0.45;
}


@media screen and (max-width: 900px) {

  .boutique-wishlist-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

}


@media screen and (max-width: 550px) {

  .boutique-wishlist-page {
    padding:
      55px
      10px
      70px;
  }

  .boutique-wishlist-page__header {
    margin-bottom: 35px;
  }

  .boutique-wishlist-grid {
    gap:
      30px
      10px;
  }

  .boutique-wishlist-card__actions {
    grid-template-columns: 1fr;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Wishlist",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "SAVED FOR LATER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Wishlist"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Keep the pieces you love in one place.</p>"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty wishlist heading",
      "default": "Your wishlist is empty"
    },
    {
      "type": "richtext",
      "id": "empty_text",
      "label": "Empty wishlist text",
      "default": "<p>Save products you love and return to them whenever you like.</p>"
    },
    {
      "type": "text",
      "id": "continue_label",
      "label": "Continue shopping label",
      "default": "SHOP ALL PRODUCTS"
    }
  ],
  "presets": [
    {
      "name": "Wishlist"
    }
  ]
}
{% endschema %}
